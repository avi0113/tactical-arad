# אפליקציה ב-Entra ID עם הרשאת Application ל-Microsoft Graph: Sites.ReadWrite.All
# (או Sites.Selected לאתר הזה בלבד), אחרי אישור מנהל.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# כתובת האתר, למשל https://contoso.sharepoint.com/sites/arad
SHAREPOINT_SITE_URL=
# אפשר במקום זאת את מזהה האתר מ-Graph: hostname,siteId,webId
# SHAREPOINT_SITE_ID=

# חלופה זמנית במקום פרטי האפליקציה. לא מתחדשת כשפג התוקף.
# SHAREPOINT_ACCESS_TOKEN=

# שמות הרשימות. אם לא מגדירים, המערכת יוצרת את שמות ברירת המחדל.
# SHAREPOINT_LIST_TASKS=משימות מבצעיות
# SHAREPOINT_LIST_EVENTS=אירועים מבצעיים
# SHAREPOINT_LIST_ACTIONS=פעולות לאירוע
# SHAREPOINT_LIST_META=מצב מערכת המשימות
